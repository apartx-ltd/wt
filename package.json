{
  "name": "@apartx/wt",
  "version": "0.1.0",
  "description": "Git-worktree dev orchestrator: one worktree per branch with deterministic ports, per-worktree env, cross-service links, host/docker instances, TUI and web dashboard",
  "keywords": ["git", "worktree", "dev", "orchestrator", "bun", "meteor", "monorepo", "ports", "tui"],
  "license": "MIT",
  "homepage": "https://github.com/apartx-ltd/wt#readme",
  "bugs": { "url": "https://github.com/apartx-ltd/wt/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/apartx-ltd/wt.git" },
  "type": "module",
  "bin": { "wt": "./cli/bin/wt.ts" },
  "exports": {
    ".": "./index.ts",
    "./plugin": "./core/src/plugin.ts",
    "./plugin-meteor": "./plugins/meteor/src/index.ts",
    "./plugin-node": "./plugins/node/src/index.ts",
    "./config-schema": "./core/schema/wt.config.schema.json"
  },
  "imports": {
    "#shared": "./shared/src/index.ts",
    "#core": "./core/src/index.ts",
    "#core/plugin": "./core/src/plugin.ts",
    "#plugins": "./plugins/registry/src/index.ts",
    "#plugin-meteor": "./plugins/meteor/src/index.ts",
    "#plugin-node": "./plugins/node/src/index.ts"
  },
  "files": [
    "index.ts",
    "cli/bin",
    "cli/src",
    "core/src",
    "core/schema",
    "server/src",
    "shared/src",
    "tui/bin",
    "tui/src",
    "plugins/meteor/src",
    "plugins/node/src",
    "plugins/registry/src",
    "web/build",
    "bunfig.toml",
    "tsconfig.json",
    "tsconfig.base.json",
    "README.md",
    "docs",
    "LICENSE",
    "History.md"
  ],
  "workspaces": ["web"],
  "engines": { "bun": ">=1.3" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "build:web": "cd web && bun run build",
    "prepack": "bun run build:web",
    "e2e": "bun tui/test/flow.e2e.tsx && bun tui/test/scroll.e2e.tsx"
  },
  "dependencies": {
    "@opentui/core": "0.4.1",
    "@opentui/solid": "0.4.1",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
